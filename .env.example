# ============================================================
#  InvoiceCRM — Cấu hình DUY NHẤT cho cả Backend lẫn Frontend
# ------------------------------------------------------------
#  • Docker đọc file này TỰ ĐỘNG khi chạy `docker compose up`.
#  • Để dùng: copy thành .env  →  `cp .env.example .env`  rồi sửa giá trị.
#  • Không bắt buộc: nếu không tạo .env, Docker vẫn chạy với giá trị mặc định.
# ============================================================

# ---------- Bảo mật ----------
JWT_SECRET=change_this_to_a_long_random_secret

# ---------- URL công khai (dùng cho link trong email + gọi API từ trình duyệt) ----------
FRONTEND_URL=http://localhost:3000
VITE_BACKEND_SERVER=http://localhost:8000/
VITE_FILE_BASE_URL=http://localhost:8000/

# ---------- Email (Mailpit — chỉ dùng để kiểm thử, không gửi ra ngoài) ----------
# Docker khởi chạy Mailpit cùng hệ thống. Mở http://localhost:8026 để xem email.
# Tên người gửi hiển thị trong hộp thư Mailpit.
MAIL_FROM=noreply@invoicecrm.test
# Khi chạy backend thủ công ngoài Docker, dùng các giá trị sau:
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

# ---------- AI (OpenAI) — TÙY CHỌN ----------
OPENAI_API_KEY=

# ---------- Database — CHỈ dùng khi chạy THỦ CÔNG (không qua Docker) ----------
# Khi chạy bằng Docker, hệ thống tự dùng MongoDB nội bộ (service 'mongo') và BỎ QUA dòng này.
DATABASE=mongodb://localhost:27017/invoice
